# /etc/systemd/system/sauvegarde.timer - Exigence B2 (copié par installer.sh)
# Prochaine exécution : systemctl list-timers sauvegarde.timer
[Unit]
Description=Sauvegarde quotidienne de /srv et /etc

[Timer]
# Tous les jours à 2 h, quand personne ne travaille
OnCalendar=*-*-* 02:00:00
# Si la machine était éteinte à 2 h, la sauvegarde manquée est faite au démarrage
Persistent=true

[Install]
WantedBy=timers.target
